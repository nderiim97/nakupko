# ---------------------------------------------------------------------------
# Nakupko store server — copy this file to .env and fill in real values.
# Never commit .env to git.
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database: SQLite locally, Postgres in production
# DATABASE_URL=sqlite:///server/nakupko.db
DATABASE_URL=postgresql+psycopg://user:password@host:5432/nakupko

# Admin bootstrap account (created on first start if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-strong-password

# Public site
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Stripe (test keys first, then live keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur

# Store details shown on the site and in e-mails
STORE_NAME=Nakupko
STORE_EMAIL=narocila@example.com
STORE_PHONE=+386 1 000 00 00
STORE_ADDRESS=Tržaška cesta 1, 1000 Ljubljana
STORE_VAT=SI00000000
STORE_IBAN=SI56 0000 0000 0000 000

# SMTP e-mail delivery (leave SMTP_HOST empty to log e-mails to the console)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=narocila@example.com
SMTP_PASSWORD=change-me
SMTP_TLS=true

# Shipping rules
FREE_SHIPPING_THRESHOLD=50
STANDARD_SHIPPING=3.99
EXPRESS_SHIPPING=6.99
COD_FEE=1.50
